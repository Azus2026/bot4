# Clave de Google Cloud (con Google Places API New y PageSpeed Insights API activadas)
# Nota: Si no la configuras aquí, la aplicación te la solicitará en la pantalla de Ajustes y se guardará de forma local en tu navegador.
GOOGLE_CLOUD_API_KEY=

# Clave de Gemini API (Google AI Studio)
# Utilizada para el análisis de sitios web, extracción de dolores y generación de borradores de outreach.
GEMINI_API_KEY=
